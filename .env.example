# ═══════════════════════════════════════════════════════════════
# IRMDS Configuration — Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
# Default: SQLite (zero config). Change to PostgreSQL for production.
IRMDS_DATABASE_URL=sqlite:///data/irmds.db

# ── Visual Module ─────────────────────────────────────────────
IRMDS_VISUAL_MODEL_PATH=models/yolov8n.pt
IRMDS_VISUAL_CONFIDENCE=0.4
IRMDS_VISUAL_IOU_THRESHOLD=0.3
IRMDS_VISUAL_LOITER_SECONDS=4
IRMDS_VISUAL_CROWD_THRESHOLD=3
IRMDS_VISUAL_SPEED_ALERT_MS=2.2
IRMDS_VISUAL_SOURCE=0

# ── Network Module ────────────────────────────────────────────
IRMDS_NETWORK_WINDOW_SECONDS=1.0
IRMDS_NETWORK_ANOMALY_CONTAMINATION=0.05
IRMDS_NETWORK_ZSCORE_THRESHOLD=3.0

# ── Finance Module ────────────────────────────────────────────
IRMDS_FINANCE_DATA_PATH=data/sample_stock.csv
IRMDS_FINANCE_VOLATILITY_WINDOW=20
IRMDS_FINANCE_FLASH_CRASH_SIGMA=3.0
IRMDS_FINANCE_REPLAY_SPEED=5.0

# ── Infrastructure Module ─────────────────────────────────────
IRMDS_INFRA_POLL_INTERVAL=2.0
IRMDS_INFRA_CPU_CRITICAL=95.0
IRMDS_INFRA_RAM_CRITICAL=90.0
IRMDS_INFRA_DISK_CRITICAL=95.0
IRMDS_INFRA_LOG_PATH=data/sample_syslog.log

# ── Alert Manager ─────────────────────────────────────────────
IRMDS_ALERT_COOLDOWN_SECONDS=10
IRMDS_ALERT_MAX_HISTORY=1000
IRMDS_ALERT_ESCALATION_WINDOW=60
IRMDS_ALERT_ESCALATION_COUNT=3

# ── Notifications ─────────────────────────────────────────────
# Leave blank to disable a channel.
IRMDS_SLACK_WEBHOOK_URL=
IRMDS_DISCORD_WEBHOOK_URL=
IRMDS_EMAIL_SMTP_HOST=
IRMDS_EMAIL_SMTP_PORT=587
IRMDS_EMAIL_FROM=
IRMDS_EMAIL_PASSWORD=
IRMDS_EMAIL_TO=
IRMDS_NOTIFY_ON_SEVERITY=CRITICAL

# ── API Server ────────────────────────────────────────────────
IRMDS_API_HOST=0.0.0.0
IRMDS_API_PORT=8000
IRMDS_CORS_ORIGINS=*
